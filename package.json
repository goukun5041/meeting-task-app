{
  "name": "meeting-task-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:netlify": "node scripts/run-netlify-dev.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "verify": "npm test && npm run build",
    "db:migrate": "node scripts/run-migrations.mjs"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "@neondatabase/serverless": "^1.1.0",
    "@netlify/functions": "^5.3.0",
    "firebase": "^12.16.0",
    "firebase-admin": "^14.1.0",
    "pinia": "^4.0.2",
    "vue": "^3.5.40",
    "vuetify": "^4.1.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "netlify-cli": "^27.0.1",
    "typescript": "^5.7.2",
    "vite": "^8.1.5",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.8"
  },
  "allowScripts": {
    "@firebase/util@1.15.1": true,
    "esbuild@0.28.1": true
  },
  "engines": {
    "node": ">=22.13 <25"
  },
  "packageManager": "npm@11.16.0"
}
